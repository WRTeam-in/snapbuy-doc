# Gemini key — EMBEDDINGS. Used by `npm run rag:index` and api/ask.js (query embedding).
# Get one free (no billing) at https://aistudio.google.com/app/apikey  (starts with AIza...)
GEMINI_API_KEY=AIza...

# Groq key — CHAT/answers. Used by api/ask.js.
# Get one free (no billing) at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Public URL of the deployed Vercel /api/ask endpoint.
# Used at build time by docusaurus.config.js (customFields.aiApiUrl).
AI_API_URL=https://YOUR-PROJECT.vercel.app/api/ask
